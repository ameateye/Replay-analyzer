# Dependencies
node_modules/

# Build output
dashboard/dist/
*.tsbuildinfo

# Built per-run data (npm run data <X> output). Whether it's published to
# external storage or copied into dashboard/public/data/ via npm run install:*
# is the operator's choice; the intermediate build artifacts stay local.
built-data/

# Playwright artifacts (diff PNGs from visual-parity failures + traces/reports)
dashboard/e2e/screenshots/
dashboard/playwright-report/
dashboard/test-results/

# Vite / editor
.vite/
.DS_Store
Thumbs.db

# Personal config (use config.example.json as a template)
config.json

# Run-local data and superseded artifacts (kept on disk, not in the repo)
extracted-data/
analysis/
charts/
dashboard-mock.html

# One-shot validators and investigation tools (see ad-hoc-analysis/README.md)
ad-hoc-analysis/

# Claude Code workspace — local overrides only (machine-specific paths, personal state)
.claude/*.local.*

# Per-user rules for AI coding agents (referenced from CLAUDE.md)
user.md


# Portable JDK + Maven for FBSR build
tools/jdk21/
tools/maven/
tools/dl/
tools/output/

# Logs
*.log
npm-debug.log*
